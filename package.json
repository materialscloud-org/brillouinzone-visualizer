{
  "name": "brillouinzone-visualizer",
  "version": "0.4.4",
  "description": "Javascript package to visualize the Brillouin zone of crystals, k-points and Fermi surfaces.",
  "homepage": "https://github.com/materialscloud-org/brillouinzone-visualizer",
  "bugs": {
    "url": "https://github.com/materialscloud-org/brillouinzone-visualizer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/materialscloud-org/brillouinzone-visualizer.git"
  },
  "license": "BSD-3-Clause",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=18",
    "three": ">=0.170.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.187.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
